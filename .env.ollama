# Env uji lokal dengan Ollama (model kecil yang mendukung tool calling). Pakai:
#   set -a; source .env.ollama; set +a; uv run ai-service serve
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
LLM_SQL_MODEL=qwen2.5:3b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_SEND_DIMENSIONS=false
AI_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/ai_service
ANALYTICS_PG_DSN=postgresql://ai_ro:ai_ro@127.0.0.1:5432/sdp_fixture
LLM_TIMEOUT_S=180
CHAT_TIMEOUT_S=300
