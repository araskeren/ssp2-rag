# =============================================================
# ai-service — contoh konfigurasi
# Salin ke .env lalu sesuaikan. File ini dipakai dua arah:
#  1. `uv run ai-service serve` di host (nilai localhost di bawah)
#  2. interpolasi compose via flag --env-file .env
#     (docker/docker-compose.{local,dev,prod}.*.yaml)
# =============================================================

# Environment aplikasi: local | dev | prod.
# Dokumentasi Swagger (/docs) HANYA di-expose saat local/dev.
APP_ENV=local

# Port HTTP native. Konvensi container = 3000; lokal pakai 3003 karena 3000 FE,
# 3001 BE, 3002 notification-service.
PORT=3003
LOG_LEVEL=info
# CORS hanya untuk dev akses langsung dari browser; produksi lewat BFF FE
# (same-origin) sehingga biarkan kosong.
CORS_ORIGIN=

# --- Database milik ai-service (Postgres + pgvector, WAJIB) ---
# Host-run: Postgres lokal (DBngin) yang sudah punya ekstensi `vector`.
# Compose: ssp2_dev_ai_postgres (image pgvector/pgvector:pg18).
AI_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/ai_service
AI_DB_POOL_SIZE=5
# true = alembic upgrade head saat boot (aman multi-replica: pg_advisory_lock).
AUTO_MIGRATE=true

# --- Auth (wajib) ---
# HARUS sama dengan JWT_SECRET backend turborepo (verifikasi token user web).
JWT_SECRET=dev-jwt-secret-samakan-dengan-backend
# API key konektor (POST /api/v1/internal/chat) — comma-separated utk rotasi key.
API_KEYS=dev-api-key
# API key admin (ingest dokumen, kanal, audit) — pisahkan dari key konektor.
ADMIN_API_KEYS=dev-admin-key
# Backend NestJS: dipanggil GET {BE_BASE_URL}/auth/profile untuk role/permission/faskes.
# Host-run: BE native. Dev compose: http://ssp2_dev_backend_1:3000.
# Prod: http://ssp2_prod_nginx/api/v1 (nginx meneruskan ke replica BE).
BE_BASE_URL=http://localhost:3001
BE_TIMEOUT_S=3
# Cache profil per sessionId (detik). Ini batas atas lag revokasi sesi.
PROFILE_CACHE_TTL_S=300
# Role (nama persis master.roles.name) yang otomatis mendapat SQL tool.
AI_ANALYST_ROLES=Administrator,Developer,Admin Pusdatin,Admin Kemenkes,Operator Kemenkes,Eksekutif Kemenkes,Eksekutif Provinsi,Eksekutif KabKota,Eksekutif Faskes
# Permission BE yang juga memberi SQL tool (sudah ada di seeder epi_intel).
AI_ANALYST_PERMISSION=menu_epi_intel:ai
# Kanal wa/tg yang tidak terdaftar di allowed_channels: public (helpdesk saja) | deny.
INTERNAL_UNKNOWN_CHANNEL_POLICY=public

# ── LLM (OpenAI-compatible) ────────────────────────────────────────────
# Endpoint apa pun yang berbicara protokol OpenAI `POST {LLM_BASE_URL}/chat/completions`
# bisa dipakai (OpenAI, Azure OpenAI, vLLM, Ollama, gateway internal).
# LLM_BASE_URL harus memuat akhiran versi. Untuk Ollama: `http://host:11434/v1`.
# LLM_API_KEY boleh dikosongkan untuk server tanpa autentikasi (Ollama, vLLM).
# Model WAJIB mendukung tool calling (OpenAI gpt-4o-mini, Qwen2.5 ≥7B via vLLM
# `--enable-auto-tool-choice --tool-call-parser hermes`, Ollama qwen2.5).
#
# PERINGATAN PRIVASI: potongan dokumen dan hasil agregat query dikirim ke LLM_BASE_URL.
# Untuk produksi gunakan endpoint on-prem, bukan layanan publik pihak ketiga.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Opsional: model berbeda (lebih kuat) khusus penulis SQL; kosong = LLM_MODEL.
LLM_SQL_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
# Batas panggilan LLM paralel per proses.
LLM_MAX_CONCURRENCY=8

# ── Registry provider LLM (DB, dikelola admin) ────────────────────────
# Selain LLM_* di atas, admin bisa mendaftarkan banyak provider lewat
# /api/v1/admin/llm/* — tipe `openai_compatible` (OpenAI, Azure, vLLM, Ollama,
# OpenRouter, gateway) dan `anthropic_compatible` (Anthropic API atau gateway yang
# berbicara Messages API) — masing-masing dengan base_url + API key sendiri, lalu
# menugaskan model per keperluan (chat/sql/judge/embedding), per role
# (public/analyst), atau per kanal (allowed_channels.llm_model_id).
# LLM_* / EMBEDDING_* tetap dipakai sebagai fallback bila belum ada penugasan.
#
# Fernet key untuk mengenkripsi API key provider di DB: `uv run ai-service llm gen-key`.
# WAJIB di dev/prod bila menyimpan API key; JANGAN diganti setelah dipakai (key lama
# tidak bisa dibuka → provider dilewati). Lokal tanpa nilai = kunci dev bawaan.
AI_SECRETS_KEY=
# Detik cache registry per proses (perubahan admin di replica lain berlaku ≤ nilai ini).
LLM_REGISTRY_TTL_S=30
# max_tokens default untuk model anthropic_compatible yang tidak mengisi max_tokens.
ANTHROPIC_DEFAULT_MAX_TOKENS=4096

# ── Embedding ─────────────────────────────────────────────────────────
# Kosong = memakai LLM_BASE_URL / LLM_API_KEY yang sama.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Cloud: text-embedding-3-small (1536). On-prem (Ollama/vLLM/TEI): bge-m3 (1024).
# Mengganti model/dimensi setelah ada data = wajib `ai-service reindex --confirm`.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# false untuk Ollama/vLLM yang menolak parameter `dimensions`.
EMBEDDING_SEND_DIMENSIONS=true

# ── RAG ───────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Jumlah potongan yang diberikan ke LLM / kandidat hybrid / konstanta RRF.
RAG_TOP_K=6
RAG_FETCH_K=20
RAG_RRF_K=60
# true = cari dokumen dulu untuk tiap pesan dan sisipkan ke prompt (lebih cepat & tangguh
# untuk model kecil); agent tetap bisa memanggil cari_dokumen lagi dengan kata kunci lain.
RAG_PREFETCH=true
# Re-ranker cross-encoder (butuh extra `uv sync --extra rerank`, torch ±2 GB).
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=4
# Berkas asli unggahan (container: /data/uploads, volume bersama antar replica).
UPLOAD_DIR=./data/uploads
INGEST_MAX_FILE_MB=25

# ── Chat / agent ──────────────────────────────────────────────────────
# Memori: N pesan terakhir (16 = 8 giliran) dipangkas ke batas token perkiraan.
CHAT_HISTORY_MESSAGES=16
CHAT_HISTORY_MAX_TOKENS=4000
CHAT_TIMEOUT_S=90
CHAT_MAX_QUERY_CHARS=2000
AGENT_MAX_TOOL_CALLS=6
SSE_HEARTBEAT_S=15
# Rate limit per replica (in-process): per principal dan per IP, per menit.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=60
# Intent router deterministik: pertanyaan berpola data (berapa/jumlah/tren/per provinsi…) memaksa
# tool_choice=analisis_data pada panggilan model pertama (membuat penolakan public selalu teraudit).
# Endpoint yang mengabaikan tool_choice (mis. Ollama) tetap aman, hanya kurang deterministik.
INTENT_FORCE_TOOL=true

# ── Analisis data (Text-to-SQL, read-only) ────────────────────────────
# postgres = DB BE satu_data_penyakit via role ai_ro (scripts/grant-ai-ro.sql)
# clickhouse = view dn_* data-pipeline via user app_ro
SQL_BACKEND=postgres
# Host-run: DB fixture lokal (tests/fixtures). Dev compose: ssp2_dev_postgres.
ANALYTICS_PG_DSN=postgresql://ai_ro:ai_ro@127.0.0.1:5432/sdp_fixture
ANALYTICS_PG_POOL_SIZE=3
ANALYTICS_CH_URL=http://localhost:3110
ANALYTICS_CH_USER=app_ro
ANALYTICS_CH_PASSWORD=
ANALYTICS_CH_DB=satu_data_penyakit
SQL_STATEMENT_TIMEOUT_MS=15000
# Baris maksimum hasil query / baris yang diperlihatkan ke LLM / koreksi ulang.
SQL_MAX_ROWS=200
SQL_LLM_ROWS=50
SQL_MAX_RETRIES=2

# =============================================================
# Khusus interpolasi compose DEV/PROD (tidak dibaca aplikasi Python)
# =============================================================
# Image dari registry (WAJIB di prod; dev boleh build lokal)
#DOCKER_IMAGE_AI=registry.gitlab.com/GRUP/PROYEK/ai-service
# Saat deploy, CI meng-export IMAGE_TAG=v<pipeline IID> (menimpa nilai ini).
#IMAGE_TAG=dev
# Port host env dev (service tunggal)
#AI_PORT=3040
# Prod: jumlah replica + range port host utk upstream nginx (samakan jumlahnya)
#AI_REPLICAS=2
#AI_PORT_RANGE=3006-3007
# Batas memori container
#AI_MEM_LIMIT=1g
#AI_PG_MEM_LIMIT=512m
# Postgres milik ai-service (compose): password superuser + port host
#AI_PG_PASSWORD=
#AI_PG_HOST_PORT=3150
# Password role read-only ai_ro di DB BE / fixture
#AI_RO_PASSWORD=
